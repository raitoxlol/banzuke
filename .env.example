# Next.js (Vercel). Leave empty for demo mode.
NEXT_PUBLIC_CONVEX_URL=

# Vercel build only: lets `npx convex deploy` push functions on each deploy.
CONVEX_DEPLOY_KEY=

# The rest live on the Convex deployment (npx convex env set ...), not in Vercel:
# AUTH_GITHUB_ID, AUTH_GITHUB_SECRET, SITE_URL, JWT_PRIVATE_KEY, JWKS  (Convex Auth)
# GITHUB_WEBHOOK_SECRET  (GitHub App webhook)
# GITHUB_TOKEN           (optional: backfill at 5000 req/h instead of 60)
